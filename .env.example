# Copy to .env for local Expo (optional).
# APK builds use fallbacks in src/config/env.js when .env is missing.
# The OpenRouter key belongs on the Admin Panel server (OPENROUTER_API_KEY), not in this app.
# Text / voice
EXPO_PUBLIC_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Meal photo vision (must support images)
EXPO_PUBLIC_AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# AdminPanel API (MongoDB JWT auth). Web: localhost. Phone: use your PC LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
